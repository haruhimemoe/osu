{
  "name": "@haruhimemoe/osu",
  "version": "0.7.0",
  "description": "osu! API v2 for the haruhime.moe tools: beatmap, beatmapset and user shapes with zod schemas (browser-safe at /shapes), a server client with token caching, a rate-budget hook, beatmaps, beatmapsets, star ratings with mods, users and matches, a browser-safe reader and writer for osu!stable's collection.db (at /collections), display formatting for beatmap stats (at /format), multiplayer matches from mp links with game winners and map wins (at /match), and the osu!lazer tournament client's bracket.json (at /tournament).",
  "keywords": [
    "osu",
    "osu!",
    "osu-api",
    "osu-api-v2",
    "api-client",
    "beatmap",
    "beatmapset",
    "star-rating",
    "collection-db",
    "multiplayer",
    "tournament",
    "bracket",
    "zod"
  ],
  "homepage": "https://github.com/haruhimemoe/osu#readme",
  "bugs": "https://github.com/haruhimemoe/osu/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haruhimemoe/osu.git"
  },
  "license": "MIT",
  "author": "David (https://dvh.sh)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shapes": {
      "types": "./dist/shapes/index.d.ts",
      "default": "./dist/shapes/index.js"
    },
    "./collections": {
      "types": "./dist/collections/index.d.ts",
      "default": "./dist/collections/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "default": "./dist/format/index.js"
    },
    "./match": {
      "types": "./dist/match/index.d.ts",
      "default": "./dist/match/index.js"
    },
    "./tournament": {
      "types": "./dist/tournament/index.d.ts",
      "default": "./dist/tournament/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:dist": "bun run build && node scripts/smoke.mjs",
    "prepublishOnly": "bun run check && bun run typecheck && bun run test && bun run test:dist",
    "check:consumer": "bun run build && node scripts/check-consumer.mjs"
  },
  "peerDependencies": {
    "zod": "^4.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "msw": "2.15.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
